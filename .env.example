# BuildTracex Environment Variables Template
# Copy this file to .env and provide your Supabase project credentials

# Supabase Project URL (found in Supabase Dashboard > Project Settings > API)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anon Public Key (safe to use in client applications)
VITE_SUPABASE_ANON_KEY=your-anon-key

# Storage Bucket Name (default: evidence)
VITE_SUPABASE_STORAGE_BUCKET=evidence
